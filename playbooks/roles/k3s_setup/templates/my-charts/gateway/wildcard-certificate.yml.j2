---
# Gateway ile ayni namespace'te durur; boylece certificateRefs cross-namespace
# olmaz ve ReferenceGrant gerekmez.
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: homelab-wildcard
  namespace: kube-system
spec:
  secretName: homelab-wildcard-tls
  duration: 8760h
  renewBefore: 2160h
  commonName: "*.{{ cluster_domain }}"
  dnsNames:
    - "*.{{ cluster_domain }}"
    - "{{ cluster_domain }}"
  issuerRef:
    name: selfsigned-issuer
    kind: ClusterIssuer

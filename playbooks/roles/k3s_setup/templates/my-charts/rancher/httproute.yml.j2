---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: rancher
  namespace: cattle-system
spec:
  # API sunucusunun varsayilan degerleri (group/kind/matches/weight) acikca yazili: liste
  # alanlarinda eksik olursa `kubectl apply` her kosuda "configured" der (D2).
  parentRefs:
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: homelab
      namespace: kube-system
      sectionName: websecure
  hostnames:
    - rancher.{{ cluster_domain }}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        # Backend HTTP/80 olmali: HTTPS/443 verilince Traefik rancher'in
        # self-signed sertifikasini dogrulayamayip 500 donduruyor.
        - group: ""
          kind: Service
          name: rancher
          port: 80
          weight: 1
